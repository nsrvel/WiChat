flowchart TB
    subgraph Client["Client Layer"]
        Web["Web & iOS (Next.js PWA)\nsingle domain + workspace picker"]
        Desktop["Desktop (Electron)\nwraps web core, auto-update later"]
        Mobile["Android (React Native APK)\nsideload, FCM push, ConnectionService"]
    end

    subgraph Gesture["Gesture/Camera AI (client-side)"]
        MP["MediaPipe (embedded)\nopt-in, default OFF on mobile"]
    end

    subgraph Edge["Core Backend — monorepo microservices (Go)"]
        direction TB
        Gateway["gateway\nHTTP /api/v1, rate limit,\npresigned URLs, export trigger"]
        Identity["identity\nauth, OAuth, sessions, guest tokens"]
        Platform["platform\nworkspaces, RBAC, channels metadata"]
        ChatSvc["chat\nmessages, WS, threads, moderation signals"]
        PresenceSvc["presence\nstatus, activity"]
        MediaControl["media\nLiveKit tokens, webhooks"]
        NotifSvc["notify\n@mention dispatch, push"]
        SearchSvc["search\nquery + ES indexer"]
        AuditSvc["audit\nKafka → audit log"]
        PluginMgr["plugins\nregistry, gRPC to plugins"]

        Gateway --> Identity
        Gateway --> Platform
        Gateway --> ChatSvc
        Gateway --> PresenceSvc
        Gateway --> SearchSvc
        Gateway --> PluginMgr
        Gateway --> MediaControl
        ChatSvc --> PresenceSvc
    end

    subgraph EventBackbone["Event Backbone"]
        Kafka["Kafka\nchat-events / audit-events /\nnotif-events / analytics-events"]
    end

    subgraph Data["Data Layer (TLS in-transit)"]
        Postgres[("PostgreSQL + JSONB\nlogical table ownership per service")]
        Redis[("Redis\npresence, guest TTL, typing,\nWS fanout, pub-sub")]
        ES[("Elasticsearch\nmessage search index")]
        MinIO[("MinIO (S3-compatible)\nfiles, avatars, soundboard\npresigned PUT/GET")]
    end

    subgraph Backup["Backup"]
        BackupJob["pg_dump + WAL archive (daily cron)"]
    end

    subgraph Obs["Observability"]
        Grafana["Grafana + Loki"]
    end

    subgraph External["Separate processes"]
        LiveKit["LiveKit Server (SFU)\nself-hosted"]
        P1["Task Board Plugin - gRPC"]
        P2["Whiteboard Plugin - gRPC"]
        P3["Virtual Office Plugin - gRPC\noptional"]
        P4["Other plugins - gRPC"]
    end

    Web --> MP
    MP -->|processed video track| LiveKit
    Web -->|REST, TLS| Gateway
    Web -->|WebSocket via gateway| ChatSvc
    Web -->|connect/publish/subscribe| LiveKit
    Web -.direct upload (presigned).-> MinIO
    Desktop -.wraps.-> Web
    Mobile -->|REST| Gateway
    Mobile -->|WS| ChatSvc
    Mobile --> LiveKit

    Identity --> Postgres
    Identity -->|guest TTL| Redis
    Platform --> Postgres
    ChatSvc --> Postgres
    ChatSvc --> Redis
    ChatSvc -->|emit| Kafka
    Kafka --> SearchSvc --> ES
    Kafka --> AuditSvc --> Postgres
    Kafka --> NotifSvc
    PresenceSvc --> Redis
    PluginMgr --> Postgres
    PluginMgr <-->|gRPC| P1
    PluginMgr <-->|gRPC| P2
    PluginMgr <-->|gRPC| P3
    PluginMgr <-->|gRPC| P4
    Gateway -.presigned URL.-> MinIO
    Postgres -.scheduled.-> BackupJob

    LiveKit -->|webhook| MediaControl
    MediaControl --> LiveKit
    Edge -.logs/metrics.-> Grafana
